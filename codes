window.runImport=async function(){
  var btn=document.getElementById('btn');var log=document.getElementById('log');
  btn.disabled=true;btn.textContent='追加中…';
  log.innerHTML='<span class="info">Firebase に接続中...</span><br>';
  var ok=0,ng=0;
  for(var i=0;i<CARDS.length;i++){
    var c=CARDS[i];
    var card={id:uid(),subject:"社会(地理)",unit:"地理 問題集",grade:"中3",questionType:"word",question:c.question,questionImage:"",answer:c.answer,answerImage:"",extraAnswers:"",hint:"",keywords:"",explanation:"",source:"問題集",importance:"",fakeChoices:c.fakeChoices,cardNo:c.n};
    try{
      await db.ref('cards/'+card.id).set(card);ok++;
      if((i+1)%10===0||i===CARDS.length-1)log.innerHTML+='<span class="ok">✓ '+(i+1)+'/'+CARDS.length+' 追加済み</span><br>';
    }catch(e){ng++;log.innerHTML+='<span class="err">✗ '+c.n+' エラー</span><br>';}
    log.scrollTop=log.scrollHeight;
    await sleep(120);
  }
  btn.textContent='完了 ✓'+ok+'問'+(ng?' ✗'+ng:'');
